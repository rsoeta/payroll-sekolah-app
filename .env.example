# Salin file ini menjadi `.env` untuk pengembangan lokal,
# atau isi nilainya pada GitHub Repository Secrets dengan nama `VITE_GAS_API_URL`.
VITE_GAS_API_URL=https://script.google.com/macros/s/GANTI_DENGAN_DEPLOYMENT_ID_ANDA/exec

# Google OAuth 2.0 Web Client ID (diperoleh dari Google Cloud Console > APIs & Services > Credentials)
# Pastikan domain aplikasi ditambahkan pada Authorized JavaScript origins.
VITE_GOOGLE_CLIENT_ID=GANTI_DENGAN_CLIENT_ID_ANDA.apps.googleusercontent.com
